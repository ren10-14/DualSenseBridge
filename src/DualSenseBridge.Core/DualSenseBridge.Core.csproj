<Project Sdk="Microsoft.NET.Sdk">

  <!--
    DualSenseBridge.Core — платформенно-независимое ядро моста:
    протокол DualSense (HID-отчёты, CRC, эффекты триггеров), клиент VIIPER,
    трансляция обратной связи, планировщик записи в контроллер.
    Не зависит от Windows-специфичных API — тестируется на любой ОС.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Version>1.0.0</Version>
    <Product>DualSenseBridge</Product>
    <Description>Мост физического DualSense (Bluetooth) &lt;-&gt; виртуальный DualSense (VIIPER/USBIP)</Description>
    <RootNamespace>DualSenseBridge.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- HID-доступ (чисто управляемая библиотека, лицензия Apache-2.0) -->
    <!-- Управление драйвером HidHide (MIT-биндинги) -->
    <PackageReference Include="Nefarius.Drivers.HidHide" Version="1.12.0" />
    <!-- HidSharp: HID-слой как в v1.9.1 (откат v1.9.8) -->
    <PackageReference Include="HidSharp" Version="2.6.4" />
    <PackageReference Include="Concentus" Version="2.2.2" />
  </ItemGroup>

</Project>
